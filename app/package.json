{
  "name": "onca3d",
  "version": "0.5.1",
  "private": true,
  "type": "module",
  "description": "Gestão local de impressão 3D",
  "author": "JAGUAR LAB",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --configLoader runner",
    "build": "vite build --configLoader runner",
    "test": "node --test tests/*.test.mjs",
    "desktop": "npm run build && electron .",
    "desktop:build": "npm run build && electron-builder --win nsis --publish never",
    "android:sync": "npm run build && cap sync android && node scripts/prepare-android.mjs",
    "android:init": "cap add android && npm run android:sync"
  },
  "dependencies": {
    "@capacitor/android": "^8.6.0",
    "@capacitor/core": "^8.6.0",
    "@capacitor/filesystem": "^8.1.5",
    "@capacitor/share": "^8.0.3",
    "fflate": "^0.8.3",
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "three": "^0.187.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.6.0",
    "@vitejs/plugin-react": "^5.2.0",
    "electron": "^45.2.1",
    "electron-builder": "^26.18.0",
    "fake-indexeddb": "^6.2.7",
    "jsdom": "^31.0.0",
    "vite": "^7.3.7"
  },
  "build": {
    "appId": "br.com.onca3d.app",
    "productName": "JAGUAR LAB",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "asar": true,
    "win": {
      "target": "nsis",
      "artifactName": "Onca3D-${version}-Setup.${ext}",
      "icon": "public/app.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "deleteAppDataOnUninstall": false
    },
    "publish": null
  }
}

